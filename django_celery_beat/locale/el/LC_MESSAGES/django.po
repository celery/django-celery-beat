#, python-format
msgid "Unable to parse JSON: %s"
msgstr "Αδυναμία ανάλυσης JSON: %s"

#: admin.py:127
msgid "Schedule"
msgstr "Προγραμματισμός"

#: admin.py:132
msgid "Arguments"
msgstr "Ορίσματα"

#: admin.py:136
msgid "Execution Options"
msgstr "Επιλογές εκτέλεσης"

#: admin.py:174
msgid "Enable selected tasks"
msgstr "Ενεργοποίηση επιλεγμένων εργασιών"

#: admin.py:182
#, python-brace-format
msgid "{0} task was successfully enabled"
msgid_plural "{0} tasks were successfully enabled"
msgstr[0] "{0} εργασία ενεργοποιήθηκε επιτυχώς"
msgstr[1] "{0} εργασίες ενεργοποιήθηκαν επιτυχώς"

#: admin.py:189
msgid "Disable selected tasks"
msgstr "Απενεργοποίηση επιλεγμένων εργασιών"

#: admin.py:197
#, python-brace-format
msgid "{0} task was successfully disabled"
msgid_plural "{0} tasks were successfully disabled"
msgstr[0] "{0} εργασία απενεργοποιήθηκε επιτυχώς"
msgstr[1] "{0} εργασίες απενεργοποιήθηκαν επιτυχώς"

#: admin.py:210
msgid "Toggle activity of selected tasks"
msgstr "Εναλλαγή κατάστασης επιλεγμένων εργασιών"

#: admin.py:218
#, python-brace-format
msgid "{0} task was successfully toggled"
msgid_plural "{0} tasks were successfully toggled"
msgstr[0] "Η κατάσταση {0} εργασίας άλλαξε επιτυχώς"
msgstr[1] "Η κατάσταση {0} εργασιών άλλαξε επιτυχώς"

#: admin.py:225
msgid "Run selected tasks"
msgstr "Εκτέλεση επιλεγμένων εργασιών"

#: admin.py:269
msgid "{0} task{1} {2} successfully run"
msgstr "Εργασίες που εκτελέστηκαν επιτυχώς: {0}"

#: admin.py:272
msgid "was,were"
msgstr "εκτελέστηκε,εκτελέστηκαν"

#: admin.py:284
msgid "Periodic Tasks Using This Schedule"
msgstr "Περιοδικές εργασίες που χρησιμοποιούν αυτόν τον προγραμματισμό"

#: apps.py:13
msgid "Periodic Tasks"
msgstr "Περιοδικές εργασίες"

