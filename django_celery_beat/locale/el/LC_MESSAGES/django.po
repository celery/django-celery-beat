#: admin.py:61
msgid "Task (registered)"
msgstr "Εργασία (καταχωρημένη)"

#: admin.py:65
msgid "Task (custom)"
msgstr "Εργασία (προσαρμοσμένη)"

#: admin.py:82
msgid "Need name of task"
msgstr "Απαιτείται το όνομα της εργασίας"

#: admin.py:88 models.py:662
msgid "Only one can be set, in expires and expire_seconds"
msgstr "Μόνο ένα από τα expires και expire_seconds μπορεί να οριστεί"

